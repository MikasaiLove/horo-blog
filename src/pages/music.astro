---
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import MusicPageContent from "@/components/pages/music/MusicPageContent.svelte";

const title = "音乐";
const description = "Mikasaの音乐库";
---

<MainGridLayout title={title} description={description}>
  <div class="w-full px-4 py-4" id="music-page">
    <MusicPageContent client:load />
  </div>
</MainGridLayout>

<script is:inline>
  // 音乐页不使用 Swup 过渡，外部链接直接全页加载
  window._musicPageLoaded = true;
</script>
